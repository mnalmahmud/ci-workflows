# project.env – Example project configuration for ci-workflows orchestrator.
#
# Copy this file to projects/<your-project-key>/project.env and fill in the
# values for your project.  The orchestrator's run_build.sh sources this file
# before executing any build commands.
#
# All variables are optional unless marked REQUIRED.  Uncomment and set only
# the variables relevant to your project.
#
# ─────────────────────────────────────────────────────────────────────────────
# Android signing (via GitHub Actions secrets)
# ─────────────────────────────────────────────────────────────────────────────
# When the secrets KEYSTORE_BASE64, KEYSTORE_ALIAS, and KEYSTORE_PASSWORD are
# set in the repository, the workflow automatically:
#   1. Decodes the keystore to /tmp/keystore.jks
#   2. Exports these env vars so your build command can use them:
#        ANDROID_KEYSTORE_PATH   – absolute path to /tmp/keystore.jks
#        ANDROID_KEY_ALIAS       – value of the KEYSTORE_ALIAS secret
#        ANDROID_KEY_PASSWORD    – value of the KEYSTORE_PASSWORD secret
#        ANDROID_STORE_PASSWORD  – value of the KEYSTORE_PASSWORD secret
#   3. Writes android/key.properties (standard Flutter/Gradle convention)
#
# For Flutter projects that read android/key.properties automatically no
# extra flags are needed in BUILD_CMD_ANDROID_APK.
#
# For plain Gradle projects that do NOT read key.properties you can pass
# signing flags directly:
#
#   BUILD_CMD_ANDROID_APK="./gradlew assembleRelease \
#     -Pandroid.injected.signing.store.file=${ANDROID_KEYSTORE_PATH} \
#     -Pandroid.injected.signing.store.password=${ANDROID_STORE_PASSWORD} \
#     -Pandroid.injected.signing.key.alias=${ANDROID_KEY_ALIAS} \
#     -Pandroid.injected.signing.key.password=${ANDROID_KEY_PASSWORD}"
#
# When the secrets are not configured the build still runs but produces an
# unsigned (debug-signed) artifact.

# ─────────────────────────────────────────────────────────────────────────────
# Toolchain flags
# ─────────────────────────────────────────────────────────────────────────────

# Set to "true" to activate the Flutter/Dart toolchain setup inside run_build.sh.
# When false (default) the Flutter setup is skipped entirely.
USE_FLUTTER=false

# ─────────────────────────────────────────────────────────────────────────────
# Android — APK build  (BUILD_VARIANT=apk)
# ─────────────────────────────────────────────────────────────────────────────

# Shell command(s) to produce an APK.  Runs inside work/target/.
# Example (Gradle — signed via env vars, see signing section above):
#   BUILD_CMD_ANDROID_APK="./gradlew assembleRelease"
# Example (Flutter — signed automatically via android/key.properties):
#   BUILD_CMD_ANDROID_APK="flutter build apk --release"
BUILD_CMD_ANDROID_APK="echo 'TODO: set BUILD_CMD_ANDROID_APK in your project.env'"

# Space-separated glob patterns (relative to work/target/) for APK output files.
# Example: "app/build/outputs/apk/release/*.apk"
ARTIFACT_GLOBS_ANDROID_APK="**/*.apk"

# ─────────────────────────────────────────────────────────────────────────────
# Android — App Bundle build  (BUILD_VARIANT=aab)
# ─────────────────────────────────────────────────────────────────────────────

# Shell command(s) to produce an AAB.
# Example (Gradle):  BUILD_CMD_ANDROID_AAB="./gradlew bundleRelease"
# Example (Flutter): BUILD_CMD_ANDROID_AAB="flutter build appbundle --release"
BUILD_CMD_ANDROID_AAB="echo 'TODO: set BUILD_CMD_ANDROID_AAB in your project.env'"

# Space-separated glob patterns for AAB output files.
# Example: "app/build/outputs/bundle/release/*.aab"
ARTIFACT_GLOBS_ANDROID_AAB="**/*.aab"

# Additional APT packages needed for Android builds (space-separated).
# Default: none.
# APT_PACKAGES_ANDROID=""

# ─────────────────────────────────────────────────────────────────────────────
# Linux build
# ─────────────────────────────────────────────────────────────────────────────

# Shell command(s) to build the Linux target.  Runs inside work/target/.
# Example (CMake): BUILD_CMD_LINUX="cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j$(nproc)"
# Example (Make):  BUILD_CMD_LINUX="make -j$(nproc)"
# Example (Flutter): BUILD_CMD_LINUX="flutter build linux --release"
BUILD_CMD_LINUX="echo 'TODO: set BUILD_CMD_LINUX in your project.env'"

# Space-separated glob patterns for Linux output files/directories.
# When PACKAGE_TAR=true the matched paths are packed into a .tar.gz archive.
# Example: "build/Release/my-app build/Release/my-app.so"
ARTIFACT_GLOBS_LINUX="build/Release/*"

# Additional APT packages to install before the Linux build (space-separated).
# Example: APT_PACKAGES_LINUX="cmake ninja-build libgtk-3-dev"
# APT_PACKAGES_LINUX=""
